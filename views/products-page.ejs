<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <h1>Products Page</h1>
     <% products?.forEach(( prod ) => { %>
      <div>
        <a href="/products/<%= prod?.id %>">
          <span><%= prod?.product_name %></span>
          <span><%= prod?.price %></span>
          <span><%= prod?.quantity %></span>
          <span><%= prod?.category_name %></span>
        </a>
      </div>
    <% }) %>    
    
    <a href="/products/create">+ Add Product</a>

    <div>
      <h3>Categories:</h3>
      <% categories?.forEach(( { category_name } ) => { %>
        <div>
          <a href="/products/category?category=<%= category_name %>"><%= category_name %></a>
        </div>
      <% }) %>
    </div>
    
  </body>
</html>
