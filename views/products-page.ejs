<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <h1>Products Page</h1>
     <% products?.forEach(( prod ) => { %>
      <div>
        <span><%= prod?.product_name %></span>
        <span><%= prod?.price %></span>
        <span><%= prod?.quantity %></span>
        <span><%= prod?.category_name %></span> 
        <button class="remove-button" data-id="<%= prod?.id %>">remove</button>
      </div>
    <% }) %>  
    
    <a href="/products/create">+ Add Product</a>

    <div>
      <h3>Categories:</h3>
      <% categories?.forEach(( { category_name } ) => { %>
        <div>
          <a href="/products/<%= category_name %>"><%= category_name %></a>
        </div>
      <% }) %>
    </div>
    
  </body>
</html>
