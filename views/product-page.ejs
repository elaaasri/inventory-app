<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <h1>Product Page</h1>
    <span><%= product?.product_name %></span>
    <span><%= product?.price %></span>
    <span><%= product?.quantity %></span>
    <span><%= product?.category_name %></span>
    <img src="<%= product?.image %>" alt="<%= product?.product_name %> image" />

    <form
      action="/products/<%= product?.id %>/delete?_method=DELETE"
      method="post"
    >
      <button type="submit" id="remove-button">remove</button>
      <input id="password-input" name="passwordInput" type="hidden" />
    </form>

    <a
      href="/products/<%= product?.id %>/edit"
      type="button"
      class="edit-button"
    >
      edit
    </a>
  </body>
</html>
