<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <h1>Add Product</h1>
    <form action="/products/create" method="post" enctype="multipart/form-data"
>
      <label for="product-name">Name:</label>
      <input id="product-name" name="prodName" type="text" />

      <label for="product-price">Price:</label>
      <input id="product-price" name="prodPrice" type="text" />

      <label for="product-quantity">Quantity:</label>
      <input id="product-quantity" name="prodQuantity" type="text" />

      <label for="category-id">Category:</label>
      <select id="category-id" name="categoryId">
        <% categories?.forEach(( cat ) => { %>
            <option value="<%= cat?.id %>"><%= cat?.category_name %></option>
        <% }); %>
      </select>

      <label for="product-image">Image:</label>
      <input id="product-image" name="prodImage" type="file" />

      <button id="submit-button" type="submit">Submit</button>
    </form>
  </body>
</html>
