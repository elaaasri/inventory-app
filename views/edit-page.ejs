<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head.ejs") %>
  <body>
    <h1>Edit Page</h1>
    
    <form action="/products/<%= product?.id %>/update?_method=PATCH" method="post">
      <img id="product-image" src="<%= product?.image %>" alt="<%= product?.product_name %> image" />
      <span id="product-name" ><%= product?.product_name %></span>

      <label for="product-price">Price:</label>
      <input
        id="product-price"
        name="prodPrice"
        type="text"
        value="<%= product?.price %>"
      />

      <label for="product-quantity">Quantity:</label>
      <input
        id="product-quantity"
        name="prodQuantity"
        type="text"
        value="<%= product?.quantity %>"
      />

      <label for="category-id">Category:</label>
        <select id="category-id" name="categoryId">
          <% categories?.forEach(( cat ) => { %>
            <option value="<%= cat?.id %>" <%= cat?.category_name == product?.category_name && 'selected' %>>
              <%= cat?.category_name %>
            </option>
        <% }); %>
      </select>

      <button id="edit-save-button" type="submit">save</button>
      <input id="password-input" name="passwordInput" type="hidden" />

    </form>
  </body>
</html>
